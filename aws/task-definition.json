{
  "_comment": "Plantilla base del task definition de ECS (Fargate) para dimo3-frontend. La imagen del contenedor la reemplaza el pipeline (AmazonECSRenderTaskDefinition). BACKEND_URL se inyecta en build time (build-arg), por lo que NO va en el task def. Ajustar los campos marcados con <<AJUSTAR>>.",
  "family": "dimo-frontend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "<<AJUSTAR_arn_rol_de_ejecucion>>",
  "taskRoleArn": "<<AJUSTAR_arn_rol_de_tarea>>",
  "containerDefinitions": [
    {
      "name": "dimo-frontend",
      "image": "placeholder_reemplazado_por_el_pipeline",
      "essential": true,
      "portMappings": [
        {
          "name": "http",
          "containerPort": 3001,
          "hostPort": 3001,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3001"
        },
        {
          "name": "HOSTNAME",
          "value": "0.0.0.0"
        },
        {
          "name": "NEXT_TELEMETRY_DISABLED",
          "value": "1"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget --quiet --tries=1 --spider http://127.0.0.1:3001/ || exit 1"
        ],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "<<AJUSTAR_nombre_log_group>>",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
