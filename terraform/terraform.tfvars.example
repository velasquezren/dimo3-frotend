# =============================================================================
# Ejemplo de variables para terraform.
#
# Copiar a terraform.tfvars y ajustar:
#   cp terraform.tfvars.example terraform.tfvars
#
# NOTA: terraform.tfvars NO se commitea (esta en .gitignore). Solo este .example.
# =============================================================================

# ID de la cuenta AWS (12 digitos). OBLIGATORIO: no tiene default.
aws_account_id = "324486142059"

# Region AWS.
aws_region = "us-east-1"

# --- Nombres de recursos (coinciden con el pipeline) ---
ecr_repository_name = "dimo-frontend"
ecs_cluster_name    = "dimo-prod-cluster"
ecs_service_name    = "dimo-frontend-svc"
task_family         = "dimo-frontend-task"
container_name      = "dimo-frontend"

# --- Capacidad de la tarea Fargate ---
container_port      = 3001
cpu                 = 256
memory              = 512
task_desired_count  = 1

# --- Imagen del contenedor ---
# Vacio = usa <ecr_uri>:latest. La imagen real la determina el pipeline en deploy.
image = ""

# --- CloudWatch Logs ---
# El log group se gestiona fuera de Terraform (la service connection no tiene
# permisos de tags sobre CloudWatch). Solo se referencia por nombre.
log_group_name = "/ecs/dimo-frontend"

# --- VPC ---
# Vacio = usar la default VPC de la cuenta.
# Si la cuenta no tiene default VPC, poner aca el ID explicito.
vpc_id = ""
