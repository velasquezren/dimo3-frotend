# ============================================================
# Dockerfile.unoptimized — Imagen Sin Optimizar (Target de Auditoría)
# ============================================================
# NOTA: Esta versión utiliza una imagen base pesada (Debian Bookworm/Bullseye),
# ejecuta el contenedor como usuario ROOT (uid=0), incluye dependencias
# de desarrollo en producción y no cuenta con HEALTHCHECK.

FROM node:20

WORKDIR /app

# Copia todo el contexto de trabajo
COPY . .

# Instalación estándar de dependencias (dev + prod)
RUN npm install

ENV NEXT_TELEMETRY_DISABLED=1

# Compilación estándar
RUN npm run build

EXPOSE 3001
ENV PORT=3001
ENV HOSTNAME="0.0.0.0"

# Ejecución como ROOT (uid=0) sin aislamiento ni HEALTHCHECK
CMD ["npm", "start"]
